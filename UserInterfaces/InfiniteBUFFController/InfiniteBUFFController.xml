<?xml version="1.0" encoding="utf-8"?>
<!-- Class 填写对应类名 -->
<Body Class="ImproveGame.UserInterfaces.InfiniteBUFFController.InfiniteBUFFController"
	Enabled="false" EnableBlur="true"
	Gap="8" BorderRadius="8" FitWidth="true" FitHeight="true" Left="50#" Top="50#"
	CrossAlignment="Stretch">
	<!-- BUFF 列表控制 -->
	<ElementGroup Name="BuffContainer" BorderRadius="8" FitWidth="true" FitHeight="true"
		FlexDirection="Column" CrossAlignment="Stretch">
		<DraggableView Name="Header" FitWidth="true" Height="36px"
			Padding="8 0" FlexDirection="Row" MainAlignment="SpaceBetween" CrossAlignment="Center">
			<!-- Title -->
			<TextView Name="Title" Text="增益控制器" TextScale="0.4" />
			<Image Name="Close" Width="30px" ImageAlign="1 0.5" />
		</DraggableView>
		<HR BackgroundColor="rgba(0,0,0,0.75)" />
		<!-- BUFF 列表 -->
		<ElementGroup FitWidth="true" FitHeight="true" FlexDirection="Column"
			CrossAlignment="Stretch" Gap="6" Padding="6">
			<ElementGroup Height="32px" CrossAlignment="Stretch">
				<ElementGroup Name="EditContainer" Gap="4" BorderRadius="6" FlexGrow="1"
					Border="2" BorderColor="rgba(0,0,0,0.5)" BackgroundColor="rgba(0,0,0,0.25)"
					CrossAlignment="Stretch">
					<!-- 输入框 -->
					<EditText Name="FilterBox"
						MaxHeight="100%" Padding="8 0" FlexGrow="1" FlexShrink="1"
						MaximumCharacters="22" TextAlign="0 0.5" TextScale="0.75" />
					<Image Name="ClearEditText" Width="28px" FitHeight="true" ImageScale="0.8"
						ImageAlign="0.5" />
				</ElementGroup>
			</ElementGroup>
			<ScrollView Name="ScrollView" FitWidth="true" FitHeight="true" CrossAlignment="Stretch"
				Gap="4">
				<M.Mask FitWidth="true" FitHeight="false" Height="200px" />
				<M.Container FitHeight="true" Width="378px" MinHeight="100%" Gap="2"
					FlexDirection="Row" FlexWrap="true" MainAlignment="Start"
					CrossContentAlignment="Start" CrossAlignment="Start">
				</M.Container>
			</ScrollView>
		</ElementGroup>
	</ElementGroup>
	<!-- 敌人生成速度调节器 -->
	<ElementGroup Name="SliderContainer" FlexDirection="Column" CrossAlignment="Stretch"
		FitHeight="true"
		Padding="12 8" Gap="8" BackgroundColor="rgba(0,0,0,0.25)" BorderRadius="8">
		<!-- Title -->
		<TextView Name="SliderTitle" Text="敌人生成率" TextScale="0.8" Padding="4" />
		<Slider Name="Slider" Height="20px" />
		<ElementGroup Name="ScaleMarks" Padding="10 0" FitHeight="true" MainAlignment="SpaceBetween" />
	</ElementGroup>
</Body>