<?xml version="1.0" encoding="utf-8"?>
<!-- Class 填写对应类名 -->
<Body Class="ImproveGame.UserInterfaces.CreateWand.CreateWandUI"
      Enabled="true" EnableBlur="true"
      Border="0" BorderColor="#00000000" BackgroundColor="#00000000"
      Gap="0" FitWidth="true" FitHeight="true" Left="50#" Top="50#">
    <ElementGroup Name="MainContainer" Border="2" BorderRadius="8"
                  FitWidth="false" FitHeight="false" Width="400px" Height="300px"
                  FlexDirection="Column" CrossAlignment="Stretch">
        <DraggableView Name="Header" FitWidth="true" Height="36px"
                       Padding="8 0" FlexDirection="Row" MainAlignment="Start" CrossAlignment="Center">
            <!-- Title -->
            <TextView Name="Title" Text="建造魔杖控制器" TextScale="0.4" FlexGrow="1" DisableMouseInteraction="true"/>
            <Image Name="Close" Width="30px" ImageAlign="1 0.5"/>
        </DraggableView>
        <HR BackgroundColor="rgba(0,0,0,0.75)"/>
        <ElementGroup FitWidth="true" FitHeight="true" FlexDirection="Column"
                      CrossAlignment="Stretch" Gap="6" Padding="6">
        </ElementGroup>
    </ElementGroup>
</Body>