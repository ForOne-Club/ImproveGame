<?xml version="1.0" encoding="utf-8"?>
<!-- Class 填写对应类名 -->
<Body Class="ImproveGame.Modules.InfiniteBuff.UserInterface.InfiniteBUFFController"
	Enabled="false" EnableBlur="true" BorderColor="#00000000" BackgroundColor="#00000000"
	Gap="0" BorderRadius="8" FitWidth="true" FitHeight="true" Left="50#" Top="50#"
	CrossAlignment="Stretch">
	<!-- BUFF 列表控制 -->
	<ElementGroup Name="MainContainer"
				  Bind.BorderColor="BorderColor" Bind.BackgroundColor="BackgroundColor"
				  Border="2" BorderRadius="8" FitWidth="true" FitHeight="true"
		FlexDirection="Column" CrossAlignment="Stretch">
		<DraggableView Name="Header" FitWidth="true" Height="36px"
			Padding="8 0" FlexDirection="Row" MainAlignment="Start" CrossAlignment="Center">
			<!-- Title -->
			<TextView Name="Title" Bind.Text="Title" TextScale="0.4" FlexGrow="1" DisableMouseInteraction="true" />
			<!-- 切换显示 -->
			<Image Width="30px" ImageAlign="1 0.5" Bind.Invalid="HiddenSliderEyeButton"
				   Bind.Command="ToggleShowSliderCommand" Bind.Texture2D="EyeSwitch" Bind.ImageColor="EyeColor" />
			<!-- 关闭 -->
			<Image Name="Close" Width="30px" ImageAlign="1 0.5" Bind.Texture2D="SearchCancel" />
		</DraggableView>
		<HR BackgroundColor="rgba(0,0,0,0.75)" />
		<!-- BUFF 列表 -->
		<ElementGroup FitWidth="true" FitHeight="true" FlexDirection="Column"
			CrossAlignment="Stretch" Gap="6" Padding="6">
			<ElementGroup Height="32px" CrossAlignment="Stretch">
				<ElementGroup Gap="4" BorderRadius="6" FlexGrow="1"
					Border="2" BorderColor="rgba(0,0,0,0.5)" BackgroundColor="rgba(0,0,0,0.25)"
					CrossAlignment="Stretch">
					<!-- 输入框 -->
					<EditText Name="InputBox" Bind.Placeholder="Placeholder"
						MaxHeight="100%" Padding="8 0" FlexGrow="1" FlexShrink="1"
						MaximumCharacters="22" TextAlign="0 0.5" TextScale="0.75" />
					<Image Name="ResetEditText" Width="28px" FitHeight="true" ImageScale="0.8"
						ImageAlign="0.5" Bind.Texture2D="SearchCancel" />
				</ElementGroup>
			</ElementGroup>
			<ScrollView Name="ScrollView" FitWidth="true" FitHeight="true" CrossAlignment="Stretch"
				Gap="4">
				<M.Mask FitWidth="true" FitHeight="false" Height="200px" />
				<M.Container FitHeight="true" Width="378px" MinHeight="100%" Gap="2"
					FlexDirection="Row" FlexWrap="true" MainAlignment="Start"
					CrossContentAlignment="Start" CrossAlignment="Start">
				</M.Container>
			</ScrollView>
		</ElementGroup>
	</ElementGroup>
	<!-- 敌人生成速度调节器 -->
	<ElementGroup Name="SliderContainer" Bind.Invalid="HiddenSlider"
				  Bind.BorderColor="BorderColor" Bind.BackgroundColor="BackgroundColor"
				  Border="2" Positioning="Absolute" Width="100%" Top="6px 100% 0#" FlexDirection="Column" CrossAlignment="Stretch"
		FitHeight="true"
		Padding="12 8" Gap="8" BackgroundColor="rgba(0,0,0,0.25)" BorderRadius="8">
		<!-- Title -->
		<TextView Bind.Text="EnemySpawnRate" TextScale="0.8" Padding="4" />
		<InfiniteBuffSlider Bind.DragCommand="SetSliderValueCommand" Bind.Value ="SliderValue" Height="20px" />
		<ElementGroup Name="MarkerContainer" Padding="10 0" FitHeight="true" MainAlignment="SpaceBetween" />
	</ElementGroup>
</Body>